# Project FORGE API — environment template
# Copy to .env and fill in. Never commit .env.
# Generate a secret with: openssl rand -hex 32

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:4200

# PostgreSQL
POSTGRES_USER=forge
POSTGRES_PASSWORD=
POSTGRES_DB=forge
DATABASE_URL=postgresql://forge:@localhost:5432/forge?schema=public

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
